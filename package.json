{
  "name": "sky-of-many-lanterns",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run generate:content && vite --host 0.0.0.0 --port 4173",
    "generate:content": "node scripts/generate-task-bank.mjs",
    "build": "npm run generate:content && tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "smoke": "node scripts/smoke-check.mjs",
    "test": "vitest run",
    "validate": "npm run generate:content && npm run lint && npm run test && node scripts/validate-content.mjs && npm run build && npm run smoke"
  },
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.0.0",
    "vitest": "^4.0.8"
  }
}
